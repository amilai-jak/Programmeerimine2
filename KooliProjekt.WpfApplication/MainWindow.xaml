<Window x:Class="KooliProjekt.WpfApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KooliProjekt.WpfApplication"
        mc:Ignorable="d"
        Title="KooliProjekt - Varad" Height="520" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="AssetsDataGrid"
                  Grid.Column="0"
                  CanUserAddRows="False"
                  AutoGenerateColumns="True"
                  ItemsSource="{Binding Data}"
                  SelectedItem="{Binding SelectedItem}" />

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock>ID</TextBlock>
            <TextBlock Text="{Binding SelectedItem.Id}"></TextBlock>

            <TextBlock Margin="0,10,0,0">Nimi</TextBlock>
            <TextBox Text="{Binding SelectedItem.Name}"></TextBox>

            <TextBlock Margin="0,10,0,0">Ticker</TextBlock>
            <TextBox Text="{Binding SelectedItem.Ticker}"></TextBox>

            <TextBlock Margin="0,10,0,0">Vara klass ID</TextBlock>
            <TextBox Text="{Binding SelectedItem.AssetClassID}"></TextBox>

            <CheckBox Margin="0,10,0,0"
                      Content="Kinnisvara"
                      IsChecked="{Binding SelectedItem.IsRealEstate}"></CheckBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">
                <Button Margin="5" Padding="5"
                        Command="{Binding AddNewCommand}">Uus</Button>
                <Button Margin="5" Padding="5"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding SelectedItem}">Salvesta</Button>
                <Button Margin="5" Padding="5"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding SelectedItem}">Kustuta</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
